          "$ref": "#/$defs/profilesSection"
        },
        "experience": {
          "$ref": "#/$defs/experienceSection"
        },
        "education": {
          "$ref": "#/$defs/educationSection"
        },
        "projects": {
          "$ref": "#/$defs/projectsSection"
        },
        "skills": {
          "$ref": "#/$defs/skillsSection"
        },
        "languages": {
          "$ref": "#/$defs/languagesSection"
        },
        "interests": {
          "$ref": "#/$defs/interestsSection"
        },
        "awards": {
          "$ref": "#/$defs/awardsSection"
        },
        "certifications": {
          "$ref": "#/$defs/certificationsSection"
        },
        "publications": {
          "$ref": "#/$defs/publicationsSection"
        },
        "volunteer": {
          "$ref": "#/$defs/volunteerSection"
        },
        "references": {
          "$ref": "#/$defs/referencesSection"
        }
      },
      "required": [
        "profiles",
        "experience",
        "education",
        "projects",
        "skills",
        "languages",
        "interests",
        "awards",
        "certifications",
        "publications",
        "volunteer",
        "references"
      ],
      "additionalProperties": false
    },
    "customSections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/customSection"
      }
    },
    "fontWeight": {
      "type": "string",
      "enum": [
        "100",
        "200",
        "300",
        "400",
        "500",
        "600",
        "700",
        "800",
        "900"
      ]
    },
    "typographyItem": {
      "type": "object",
      "properties": {
        "fontFamily": {
          "type": "string"
        },
        "fontWeights": {
          "type": "array",
          "default": [
            "400"
          ],
          "items": {
            "$ref": "#/$defs/fontWeight"
          }
        },
        "fontSize": {
          "type": "number",
          "minimum": 6,
          "maximum": 24,
          "default": 11
        },
        "lineHeight": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 4,
          "default": 1.5
        }
      },
      "required": [
        "fontFamily",
        "fontWeights",
        "fontSize",
        "lineHeight"
      ],
      "additionalProperties": false
    },
    "pageLayout": {
      "type": "object",
      "properties": {
        "fullWidth": {
          "type": "boolean"
        },
        "main": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sidebar": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "fullWidth",
        "main",
        "sidebar"
      ],
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "sidebarWidth": {
          "type": "number",
          "minimum": 10,
          "maximum": 50,
          "default": 35
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pageLayout"
          }
        }
      },
      "required": [
        "sidebarWidth",
        "pages"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "gapX": {
          "type": "number",
          "minimum": 0
        },
        "gapY": {
          "type": "number",
          "minimum": 0
        },
        "marginX": {
          "type": "number",
          "minimum": 0
        },
        "marginY": {
          "type": "number",
          "minimum": 0
        },
        "format": {
          "type": "string",
          "enum": [
            "a4",
            "letter",
            "free-form"
          ],
          "default": "a4"
        },
        "locale": {
          "type": "string",
          "default": "en-US"
        },
        "hideLinkUnderline": {
          "type": "boolean",
          "default": false
        },
        "hideIcons": {
          "type": "boolean",
          "default": false
        },
        "hideSectionIcons": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "gapX",
        "gapY",
        "marginX",
        "marginY",
        "format",
        "locale",
        "hideLinkUnderline",
        "hideIcons",
        "hideSectionIcons"
      ],
      "additionalProperties": false
    },
    "level": {
      "type": "object",
      "properties": {
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "type": {
          "type": "string",
          "enum": [
            "hidden",
            "circle",
            "square",
            "rectangle",
            "rectangle-full",
            "progress-bar",
            "icon"
          ]
        }
      },
      "required": [
        "icon",
        "type"
      ],
      "additionalProperties": false
    },
    "colors": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "background": {
          "type": "string"
        }
      },
      "required": [
        "primary",
        "text",
        "background"
      ],
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "properties": {
        "level": {
          "$ref": "#/$defs/level"
        },
        "colors": {
          "$ref": "#/$defs/colors"
        }
      },
      "required": [
        "level",
        "colors"
      ],
      "additionalProperties": false
    },
    "typography": {
      "type": "object",
      "properties": {
        "body": {
          "$ref": "#/$defs/typographyItem"
        },
        "heading": {
          "$ref": "#/$defs/typographyItem"
        },
        "entryTitleSize": {
          "type": "number",
          "minimum": 6,
          "maximum": 24,
          "default": 12
        },
        "entrySubtitleSize": {
          "type": "number",
          "minimum": 6,
          "maximum": 24,
          "default": 10
        },
        "entryMetaSize": {
          "type": "number",
          "minimum": 6,
          "maximum": 24,
          "default": 9
        }
      },
      "required": [
        "body",
        "heading",
        "entryTitleSize",
        "entrySubtitleSize",
        "entryMetaSize"
      ],
      "additionalProperties": false
    },
    "template": {
      "type": "string",
      "enum": [
        "cyndaquil",
        "mewtwo"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "template": {
          "$ref": "#/$defs/template",
          "default": "cyndaquil"
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "page": {
          "$ref": "#/$defs/page"
        },
        "design": {
          "$ref": "#/$defs/design"
        },
        "typography": {
          "$ref": "#/$defs/typography"
        },
        "notes": {
          "type": "string"
        },
        "styleRules": {
          "default": []
        }
      },
      "required": [
        "template",
        "layout",
        "page",
        "design",
        "typography",
        "notes",
        "styleRules"
      ],
      "additionalProperties": false
    }
  }
}
