          "type": "string",
          "minLength": 1,
          "description": "The overarching skill category or heading, such as Frontend, Backend, Languages, Cloud, DevOps, or Soft Skills. This is not an individual keyword."
        },
        "proficiency": {
          "type": "string",
          "description": "Optional proficiency label for the category. Leave empty unless the source explicitly provides a proficiency statement."
        },
        "level": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "default": 0,
          "description": "Optional 0-5 display level. Use a non-zero value only when the source explicitly provides a rating or level."
        },
        "keywords": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Concrete skills, tools, technologies, methods, or soft-skill terms that belong inside this category. Populate this array when the source provides terms; do not create one category per keyword."
